{
  "compilerOptions": {
    "target": "es6",
    "module": "nodenext",
    "experimentalDecorators": true,
    "strict": true,
    "strictNullChecks": false,
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "stripInternal": true,
    "types": ["@cocos/creator-types/engine", "@cocos/creator-types/editor"]
  },
  "exclude": ["node_modules", "dist", "build"]
}
